NODE_ENV=development
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=smart_gate
DATABASE_PASSWORD=smart_gate
DATABASE_NAME=smart_gate
# Để `false` ở MỌI môi trường, kể cả dev: schema chỉ được đổi qua migration.
# Bật `true` sẽ khiến TypeORM tự sửa schema dev và làm dev lệch dần khỏi production.
# Khi DATABASE_MIGRATIONS_RUN=true thì biến này bị BỎ QUA (hai cơ chế không được cùng bật).
DATABASE_SYNC=false

# Tự áp dụng migration đang chờ lúc khởi động (`migrationsRun` của TypeORM). Thay cho
# stage `migrate` của CI — Runner ngoài cụm không nối được tới database. Migration hỏng
# ⇒ ứng dụng không khởi động. Đặt `false` để tự chạy `npm run migration:run` bằng tay.
DATABASE_MIGRATIONS_RUN=true

# Ghi nhận nền — MẶC ĐỊNH TẮT. Đặt `true` để đánh dấu migration là đã áp dụng mà KHÔNG
# chạy chúng (như `migration:run --fake`), dùng cho database có schema ĐẦY ĐỦ nhưng bảng
# `migrations` trống. Khởi động MỘT lần rồi GỠ RA. Đừng bật khi schema chưa đầy đủ —
# schema sẽ bị khoá lại ở mức thiếu bảng (sự cố production 2026-08-01).
# DATABASE_MIGRATIONS_BASELINE=
API_PREFIX=api/v1
# Bắt buộc ở môi trường production — thiếu biến này API sẽ dừng khởi động.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=28800
# Thời hạn sống của Refresh Token (giây), mặc định 7 ngày (604800 giây).
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Kho lưu trữ tệp đính kèm (F11) — giao thức S3, dùng được cho cả MinIO lẫn AWS S3.
# Đây là cách đóng rủi ro R8: tệp lưu trong container sẽ MẤT khi deploy lại.
#
# Bỏ trống cả nhóm này thì API vẫn khởi động bình thường (ghi log cảnh báo lúc
# khởi động), nhưng mọi thao tác tải tệp lên/về sẽ trả lỗi 503 kèm thông báo
# tiếng Việt. Nhờ vậy dev không bị chặn khi chưa dựng MinIO.
#
# KHÔNG đặt khoá thật vào `.env`, `.env.production`, `.env.testing` — 3 tệp này
# đã bị commit vào repo. Khoá thật cấp qua biến môi trường của CI/CD.
# ---------------------------------------------------------------------------
# MinIO: http://localhost:9000 (hoặc URL của cụm). AWS S3 thật: để trống.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=smart-gate-attachments
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# MinIO bắt buộc `true` (bucket nằm trong đường dẫn); AWS S3 thật đặt `false`
# (bucket là subdomain). Mặc định khi không khai là `true`.
STORAGE_S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Kho bãi (F42/F44) — số giờ lưu bãi tối đa, dùng để tính "dự kiến rời bãi" và
# cờ "quá hạn" trên sơ đồ kho bãi (UI-10). Bỏ trống hoặc sai định dạng thì rơi
# về mặc định 48 giờ. Đây là tham số cấu hình, KHÔNG phải secret.
# ---------------------------------------------------------------------------
YARD_MAX_STORAGE_HOURS=48

# ---------------------------------------------------------------------------
# Thu phí (UI-11) — số giờ hạn thanh toán phí, dùng để gắn cờ "quá hạn" và đếm
# KPI "Quá hạn" trên màn thu phí. Bỏ trống hoặc sai định dạng thì rơi về mặc
# định 72 giờ. Đây là tham số cấu hình, KHÔNG phải secret.
# ---------------------------------------------------------------------------
FEE_PAYMENT_DEADLINE_HOURS=72

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@example.com
