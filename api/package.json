{
  "name": "smart-gate-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for Smart Gate / Cua Khau So using clean architecture and PostgreSQL.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d typeorm-cli.config.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:check": "node scripts/check-migrations.js",
    "boot:check": "node scripts/check-boot.js",
    "storage:check": "node scripts/check-storage.js",
    "seed": "node scripts/seed-30-dossiers.js",
    "seed:audit": "node scripts/seed-audit-logs.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.17.0",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
