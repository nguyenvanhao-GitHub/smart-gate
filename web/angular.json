{
  "$schema": "https://json.schemastore.org/angular-cli",
  "version": 1,
  "projects": {
    "smart-gate-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/smart-gate-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "assets": ["src/assets"],
            "optimization": {
              "fonts": false
            }
          },
          "configurations": {
            "testing": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.testing.ts"
                }
              ]
            },
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ],
              "outputHashing": "all"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "styles": ["src/styles.scss"],
            "browsers": "ChromeHeadlessCI",
            "watch": false
          },
          "configurations": {
            "watch": {
              "watch": true,
              "browsers": "Chrome"
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "smart-gate-web:build"
          },
          "configurations": {
            "testing": {
              "buildTarget": "smart-gate-web:build:testing"
            },
            "production": {
              "buildTarget": "smart-gate-web:build:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "af8c6da0-7309-4149-a1d7-c5bad5982774"
  }
}
